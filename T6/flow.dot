digraph G { rankdir=TB; node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#eef3fb"]; edge [fontname="Helvetica", fontsize=9];
in [label="5 department files\nCSE.txt ECE.txt MECH.txt CIVIL.txt IT.txt", fillcolor="#fff2cc"];
open [label="open file (with)\nread one line at a time", shape=box];
miss [label="file missing / unreadable\nlog MISSING or UNREADABLE\ncontinue with next file", fillcolor="#f4cccc"];
blank [label="blank line?\nskip", shape=diamond, fillcolor="#ffffff"];
parse [label="VALIDATE parse_registration()\n5 fields, 9-digit number, name, dept,\ne-mail (string methods), events", shape=box, fillcolor="#d9ead3"];
bad [label="InvalidRegistration\nlog DAMAGED / INVALID with\nfile name + line number", fillcolor="#f4cccc"];
dup [label="DUPLICATE?  reg in seen (set/dict)", shape=diamond, fillcolor="#ffffff"];
merge [label="keep first entry,\nmerge events, log DUPLICATE", fillcolor="#fce5cd"];
add [label="add to master dict\nseen[reg] = (file, line)"];
w1 [label="master.csv\n(sorted)", fillcolor="#d9ead3"]; w2 [label="events/<Event>.txt\none file per event", fillcolor="#d9ead3"];
w3 [label="summary.txt", fillcolor="#d9ead3"]; w4 [label="errors.log", fillcolor="#f4cccc"];
in -> open; open -> miss [label="OSError"]; open -> blank; blank -> parse [label="no"]; blank -> open [label="yes"];
parse -> bad [label="raises"]; parse -> dup [label="ok"]; bad -> open [label="next line"]; dup -> merge [label="yes"]; dup -> add [label="no"];
merge -> open; add -> open; miss -> w4 [style=dashed]; bad -> w4 [style=dashed]; merge -> w4 [style=dashed];
open -> w1 [label="all files done", style=dotted]; w1 -> w2 [style=dotted]; w2 -> w3 [style=dotted];
}
